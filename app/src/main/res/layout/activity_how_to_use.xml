<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.feature.how_to_use.HowToUseActivity">

    <ImageView
        android:id="@+id/icBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/icback" />

    <TextView
        android:id="@+id/tvlabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:text="@string/how_to_use"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/icBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/icBack"
        app:layout_constraintTop_toTopOf="@+id/icBack" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvlabel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:padding="16dp"
                android:text="@string/_1_turn_on_to_enable_the_feature"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:paddingHorizontal="4dp"
                app:srcCompat="@drawable/img_how_to_use1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/_2_adjust_overlay_opacity"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:paddingHorizontal="16dp"
                android:text="@string/adjust_the_opacity_level_of_the_privacy_overlay_for_different_device_states"
                android:textColor="#767676"
                android:textSize="14sp" />
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:paddingHorizontal="4dp"

                android:scaleType="fitCenter"
                app:srcCompat="@drawable/img_how_to_use2" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/_3_panel_settings"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:paddingHorizontal="16dp"
                android:text="@string/control_the_visibility_and_opacity_of_the_control_panel_displayed_on_screen"
                android:textColor="#767676"
                android:textSize="14sp" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:paddingHorizontal="4dp"

                app:srcCompat="@drawable/img_how_to_use3" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/_4_tilt_sensitivity"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"

                android:paddingHorizontal="16dp"
                android:text="@string/configure_how_the_app_responds_to_device_tilt_including_sensitivity_and_trigger_direction"
                android:textColor="#767676"
                android:textSize="14sp" />


            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:paddingHorizontal="4dp"

                app:srcCompat="@drawable/img_how_to_use4" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>