<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mam_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- Top Header: Brand & Icons -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivLogoTx"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_mam_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@id/ivLogoTx"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_bold"
                    android:text="Mầm Money ◆"
                    android:textColor="@color/mam_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_medium"
                    android:text="@string/mam_slogan"
                    android:textColor="@color/mam_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivBellCompare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="6dp"
                    android:src="@drawable/ic_mam_bell" />

                <ImageView
                    android:id="@+id/ivAvatarCompare"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_mam_avatar" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_mam_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search_mam"
                app:tint="@color/mam_text_secondary" />

            <EditText
                android:id="@+id/edtSearchTx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:fontFamily="@font/inter_24pt_regular"
                android:hint="@string/mam_search_hint"
                android:textColor="@color/mam_text_primary"
                android:textColorHint="@color/mam_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Filter Chips Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_mam_pill_green"
                android:fontFamily="@font/inter_24pt_semibold"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="Tất cả (42)"
                android:textColor="@color/mam_primary_dark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterExpense"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mam_pill_white"
                android:fontFamily="@font/inter_24pt_medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="● Chi tiêu (38)"
                android:textColor="@color/mam_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/chipFilterIncome"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mam_pill_white"
                android:fontFamily="@font/inter_24pt_medium"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="● Thu nhập (4)"
                android:textColor="@color/mam_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Card: Dòng tiền Tháng 10 -->
        <LinearLayout
            android:id="@+id/cardCashflowReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_mam_card"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_bold"
                    android:text="● Dòng tiền Tháng 10"
                    android:textColor="@color/mam_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:fontFamily="@font/inter_24pt_semibold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="@string/mam_status_positive"
                    android:textColor="@color/mam_primary_dark"
                    android:textSize="11sp" />
            </RelativeLayout>

            <!-- 3 Columns Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Col 1: Tổng thu -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mam_pill_gray"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_medium"
                        android:text="↓ Tổng thu"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTxTotalIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="+12.000..."
                        android:textColor="@color/mam_primary_dark"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Col 2: Tổng chi -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mam_pill_gray"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_medium"
                        android:text="↑ Tổng chi"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTxTotalExpense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-3.550.0..."
                        android:textColor="@color/mam_expense_red"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Col 3: Còn lại -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mam_pill_green"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_medium"
                        android:text="Còn lại"
                        android:textColor="@color/mam_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTxRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="+8.450...."
                        android:textColor="@color/mam_primary_dark"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ratio Progress Bar -->
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="30"
                android:progressDrawable="@drawable/progress_bar_mam_green" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_24pt_medium"
                    android:text="@string/mam_cashflow_spent_percent"
                    android:textColor="@color/mam_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:fontFamily="@font/inter_24pt_medium"
                    android:text="@string/mam_cashflow_saved_percent"
                    android:textColor="@color/mam_primary"
                    android:textSize="11sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Gesture Hint & Group count -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_medium"
                android:text="@string/mam_gesture_hint"
                android:textColor="@color/mam_text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvGroupCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/inter_24pt_medium"
                android:text="@string/mam_group_count"
                android:textColor="@color/mam_text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <!-- Group 1: Hôm nay 24 Tháng 10 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_bold"
                android:text="Hôm nay 24 Tháng 10"
                android:textColor="@color/mam_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/inter_24pt_semibold"
                android:text="Chi: -365.000 đ"
                android:textColor="@color/mam_expense_red"
                android:textSize="12sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mam_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <!-- Item: Phở Bò Bát Đàn -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/ivPho"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_cat_food"
                    app:tint="@color/mam_primary_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivPho"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_semibold"
                        android:text="Phở Bò Bát Đàn"
                        android:textColor="@color/mam_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="Ăn uống • Tiền mặt"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-55.000 đ"
                        android:textColor="@color/mam_expense_red"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="08:15"
                        android:textColor="@color/mam_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mam_divider" />

            <!-- Item: Grab Car đi làm -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/ivGrab"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_cat_transport"
                    app:tint="@color/mam_primary_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivGrab"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_semibold"
                        android:text="Grab Car đi làm"
                        android:textColor="@color/mam_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="Di chuyển • Techcombank"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-85.000 đ"
                        android:textColor="@color/mam_expense_red"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="07:45"
                        android:textColor="@color/mam_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mam_divider" />

            <!-- Item: Mua sách Fahasa -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/ivBook"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_cat_education"
                    app:tint="@color/mam_primary_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivBook"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_semibold"
                        android:text="Mua sách Fahasa"
                        android:textColor="@color/mam_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="Giáo dục • Ví MoMo"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-225.000 đ"
                        android:textColor="@color/mam_expense_red"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="14:20"
                        android:textColor="@color/mam_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>

        <!-- Group 2: Hôm qua 23 Tháng 10 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_24pt_bold"
                android:text="Hôm qua 23 Tháng 10"
                android:textColor="@color/mam_text_primary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/inter_24pt_semibold"
                android:text="Chi: -1.240.000 đ"
                android:textColor="@color/mam_expense_red"
                android:textSize="12sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_mam_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <!-- Item: Tiền điện EVN -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/ivEvn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_lightning_item" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivEvn"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_semibold"
                        android:text="Tiền điện EVN"
                        android:textColor="@color/mam_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="Hóa đơn • MB Bank"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-640.000 đ"
                        android:textColor="@color/mam_expense_red"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="20:10"
                        android:textColor="@color/mam_text_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/mam_divider" />

            <!-- Item: Siêu thị Tops Market -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <ImageView
                    android:id="@+id/ivTops"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_mam_pill_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_cat_shopping"
                    app:tint="@color/mam_primary_dark" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/ivTops"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_semibold"
                        android:text="Siêu thị Tops Market"
                        android:textColor="@color/mam_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="Ăn uống • Techcombank"
                        android:textColor="@color/mam_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_bold"
                        android:text="-600.000 đ"
                        android:textColor="@color/mam_expense_red"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_24pt_regular"
                        android:text="18:30"
