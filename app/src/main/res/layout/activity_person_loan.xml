<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black1_in_app">

    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/icBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            app:srcCompat="@drawable/icback" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/person_loan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/icChangeDollar"
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_change_dollar" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@id/frAds"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@id/info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loan_amount"
                app:drawableRightCompat="@drawable/ic_info" />

            <EditText
                android:id="@+id/edtAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_item_dark"
                android:drawableEnd="@drawable/ic_dollar"
                android:inputType="numberDecimal"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tvErrorAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/max_12_digits_allowed"
                android:textColor="#FA4838"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/interest_rate"
                app:drawableRightCompat="@drawable/ic_info" />

            <EditText
                android:id="@+id/edtRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_item_dark"
                android:drawableEnd="@drawable/ic_percent"
                android:inputType="numberDecimal"
                android:padding="16dp" />

            <TextView
                android:id="@+id/tvErrorRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/the_annual_interest_rate_cannot_exceed_999"
                android:textColor="#FA4838"

                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/info2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/loan_term"
                app:drawableRightCompat="@drawable/ic_info" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtTerm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="20dp"
                    android:layout_weight="0.5"
                    android:background="@drawable/bg_item_dark"
                    android:inputType="number"
                    android:padding="16dp" />

                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="0.5"
                    android:background="@drawable/bg_spinner_with_arrow"
                    android:overlapAnchor="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="40dp"
                    android:spinnerMode="dropdown" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrorTerm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/the_loan_term_cannot_exceed_360_months"
                android:textColor="#FA4838"
                android:textSize="12sp"

                android:visibility="gone" />

            <TextView
                android:id="@+id/tvErrorTermYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/the_loan_term_cannot_exceed_30_year"
                android:textColor="#FA4838"
                android:textSize="12sp"

                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/start_date" />

            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_item_dark"
                android:drawableEnd="@drawable/ic_date"
                android:focusable="false"
                android:padding="16dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_reset"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/reset_fields"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnCalc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_caculate"
                    android:fontFamily="@font/poppins_semi_bold"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="@string/calculate"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/frAds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>